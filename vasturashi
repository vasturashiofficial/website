<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Vastu Rashi</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, Helvetica, sans-serif;
    }

    body{
      background:#f4f4f4;
      color:#222;
      line-height:1.6;
    }

    a{
      text-decoration:none;
    }

    .container{
      width:90%;
      max-width:1200px;
      margin:auto;
    }

    /* HERO */

    .hero{
      height:100vh;
      background:url('https://images.unsplash.com/photo-1462331940025-496dfbfc7564?q=80&w=1974&auto=format&fit=crop') center/cover no-repeat;
      position:relative;
      color:white;
    }

    .overlay{
      background:rgba(0,0,0,0.35);
      width:100%;
      height:100%;
      padding:30px;
    }

    nav{
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    .logo{
      font-size:28px;
      font-weight:bold;
      letter-spacing:2px;
    }

    .btn{
      background:#73d7ff;
      color:white;
      padding:12px 22px;
      border-radius:4px;
      display:inline-block;
    }

    .hero-content{
      margin-top:150px;
    }

    .hero-content h1{
      font-size:70px;
      font-weight:700;
    }

    .hero-content p{
      font-size:22px;
      margin-top:10px;
    }

    /* ABOUT */

    .about{
      background:white;
      padding:80px 0;
    }

    .about-wrapper{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:60px;
      align-items:center;
    }

    .about img{
      width:100%;
      border-radius:8px;
    }

    .about h2{
      font-size:48px;
      margin-bottom:20px;
    }

    .about p{
      color:#555;
      margin-bottom:25px;
    }

    .purple-btn{
      background:#7f74ff;
      color:white;
      padding:12px 24px;
      border-radius:5px;
      display:inline-block;
    }

    /* SERVICES */

    .services{
      padding:80px 0;
      background:#faf7f4;
    }

    .section-title{
      text-align:center;
      font-size:42px;
      margin-bottom:50px;
    }

    .cards{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:30px;
    }

    .card{
      background:white;
      border-radius:8px;
      overflow:hidden;
      box-shadow:0 4px 15px rgba(0,0,0,0.08);
      transition:0.3s;
    }

    .card:hover{
      transform:translateY(-5px);
    }

    .card img{
      width:100%;
      height:220px;
      object-fit:cover;
    }

    .card-content{
      padding:20px;
      text-align:center;
    }

    .card-content h3{
      margin-bottom:10px;
      font-size:22px;
    }

    .card-content p{
      color:#666;
      font-size:14px;
    }

    /* TESTIMONIALS */

    .testimonials{
      background:white;
      padding:80px 0;
    }

    .testimonial-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:40px;
    }

    .testimonial{
      background:#f5f5f5;
      padding:25px;
      border-radius:8px;
    }

    .testimonial p{
      margin-bottom:10px;
    }

    .testimonial h4{
      color:#6a5cff;
    }

    /* SOCIAL */

    .social{
      padding:80px 0;
      text-align:center;
    }

    .social h2{
      font-size:44px;
      margin-bottom:20px;
    }

    .social-icons{
      margin-top:20px;
    }

    .social-icons a{
      margin:0 10px;
      font-size:24px;
      color:#222;
    }

    /* CONTACT */

    .contact{
      background:white;
      padding:80px 0;
    }

    .contact-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:50px;
      align-items:center;
    }

    .contact img{
      width:100%;
      border-radius:8px;
    }

    .contact h2{
      font-size:48px;
      margin-bottom:20px;
    }

    .contact-info p{
      margin-bottom:15px;
      color:#555;
    }

    footer{
      background:#111;
      color:white;
      text-align:center;
      padding:20px;
    }

    @media(max-width:768px){

      .hero-content h1{
        font-size:45px;
      }

      .about-wrapper,
      .testimonial-grid,
      .contact-grid{
        grid-template-columns:1fr;
      }

      .section-title{
        font-size:34px;
      }
    }
  </style>
</head>

<body>

